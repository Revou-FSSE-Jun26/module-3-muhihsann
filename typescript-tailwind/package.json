{
  "name": "typed-product-catalog",
  "version": "1.0.0",
  "description": "Typed, interactive product catalog with TypeScript + Tailwind CSS (RevOnest Checkpoint 1).",
  "private": true,
  "scripts": {
    "build:ts": "tsc",
    "watch:ts": "tsc --watch",
    "build:css": "tailwindcss -i ./src/input.css -o ./dist/output.css",
    "watch:css": "tailwindcss -i ./src/input.css -o ./dist/output.css --watch",
    "build:home": "tailwindcss -i ../home/src/input.css -o ../home/dist/output.css",
    "build": "npm run build:ts && npm run build:css && npm run build:home"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0"
  }
}
